---
/**
 * Slim, thumb-reach booking bar for phones. Appears once the opening screen has scrolled away,
 * hides over the signature sequence, the closing invitation, any form and the footer, and while the menu is open.
 */
import { site } from '../data/site';
---
<div class="mcta" id="mobile-cta" aria-hidden="true">
  <a class="mcta__book" href={site.cta.href}><span class="mcta__long">{site.cta.label}</span><span class="mcta__short">Book a free appointment</span></a>
  <a class="mcta__call" href={site.phoneHref} aria-label={`Call ${site.phone}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg></a>
</div>
<script>
  const bar = document.getElementById('mobile-cta');
  if (bar && matchMedia('(max-width: 899px)').matches) {
    const avoid = Array.from(document.querySelectorAll('.m2s, .close, .z-cta, footer, form, .hero, .page-head, .bh'));
    let past = false; const near = new Set<Element>();
    const apply = () => { const on = past && near.size === 0 && !document.body.classList.contains('menu-open'); bar.classList.toggle('is-on', on); bar.setAttribute('aria-hidden', String(!on)); };
    const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) near.add(e.target); else near.delete(e.target); }); apply(); }, { rootMargin: '0px 0px -40px 0px', threshold: 0.02 });
    avoid.forEach((el) => io.observe(el));
    const onScroll = () => { const p = scrollY > innerHeight * 0.7; if (p !== past) { past = p; apply(); } };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
    new MutationObserver(apply).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  }
</script>
<style>
  .mcta { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 14; display: none; gap: 8px; transform: translateY(120%); opacity: 0; transition: transform .35s cubic-bezier(.2,.7,.2,1), opacity .3s; pointer-events: none; }
  .mcta.is-on { transform: none; opacity: 1; pointer-events: auto; }
  .mcta__book { flex: 1; min-height: 52px; display: flex; align-items: center; justify-content: center; background: rgba(15,17,20,.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: var(--on-panel); border: 1px solid rgba(255,255,255,.14); text-decoration: none; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; }
  .mcta__call { width: 52px; min-height: 52px; display: grid; place-items: center; background: var(--brass-light); color: var(--panel-dark); text-decoration: none; }
  .mcta__short { display: none; }
  @media (max-width: 899px) { .mcta { display: flex; } }
  @media (max-width: 374px) { .mcta__long { display: none; } .mcta__short { display: inline; } }
  @media (prefers-reduced-motion: reduce) { .mcta { transition: none; } }
</style>
