---
/** What the price includes — the showroom case, stated positively. Used on brand pages. */
import { site } from '../data/site';
interface Props { brand: string; room?: 'kitchen' | 'bathroom' | 'surfaces' }
const { brand, room = 'bathroom' } = Astro.props;
const made = room === 'kitchen' ? 'the kitchen it goes into' : room === 'surfaces' ? 'the room it finishes' : 'the bathroom it goes into';
---
<section class="ob">
  <div class="wrap ob__in">
    <div class="z-heading">
      <span class="z-eyebrow">What the price includes</span>
      <h2>{brand}, and {made}.</h2>
      <p class="z-heading__lead">A {brand} quote from us comes with the design, the survey, a specification where every part is named, a check that it all fits together before it is ordered, and a designer to call once it is in. We are open about price and happy to compare any quote like for like in the showroom.</p>
    </div>
    <div class="ob__acts">
      <a class="z-btn z-btn--primary" href={site.cta.href}>{site.cta.label}</a>
      <a class="z-btn z-btn--secondary" href="/about/showroom">Visit the showroom</a>
      <a class="z-btn z-btn--link" href="/contact">Ask a question <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></a>
    </div>
  </div>
</section>
<style>
  .ob { padding-block: var(--space-9); border-top: var(--hairline) solid var(--line); border-bottom: var(--hairline) solid var(--line); }
  .ob__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-8); align-items: center; }
  .ob__acts { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  @media (max-width: 900px) { .ob__in { grid-template-columns: 1fr; } }
</style>
