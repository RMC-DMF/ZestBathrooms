---
import Pic from './Pic.astro';
/**
 * Editorial composition — the grid-break. One large photograph bleeding to the viewport edge,
 * a smaller detail overlapping its corner, and a short statement beside them.
 * tone="light" puts it on the warm stone ground (re-scoped light tokens).
 */
import type { Accent } from '../data/site';
interface Props {
  image: string; alt: string;
  detail?: string; detailAlt?: string;
  eyebrow?: string; title: string; text?: string;
  href?: string; linkLabel?: string;
  flip?: boolean; tone?: 'dark' | 'light'; accent?: Accent; position?: string; number?: string; overlap?: boolean;
}
const { image, alt, detail, detailAlt = '', eyebrow, title, text, href, linkLabel = 'Explore', flip = false, tone = 'dark', accent, position = '50% 50%', number, overlap = false } = Astro.props;
---
<section class:list={['ed', `ed--${tone}`, { 'ed--flip': flip, 'ed--overlap': overlap }, accent && `z-accent--${accent}`]} data-theme={tone === 'light' ? 'light' : undefined}>
  <div class="wrap ed__in">
    <div class="ed__media">
      <div class="ed__img"><Pic src={image} alt={alt} position={position} sizes="(max-width: 900px) 100vw, 60vw" widths={[640, 960, 1280, 1600, 1920]} /></div>
      {detail && <div class="ed__detail"><Pic src={detail} alt={detailAlt} sizes="(max-width: 900px) 50vw, 24vw" widths={[320, 480, 640, 800]} /></div>}
    </div>
    <div class="ed__txt">
      {eyebrow && <div class="ed__mark">{number && <span class="ch-num">{number}</span>}<span class="z-eyebrow">{eyebrow}</span></div>}
      <h2 class="ed__title">{title}</h2>
      {text && <p class="ed__lead">{text}</p>}
      {href && <a class:list={['z-btn z-btn--link', { 'z-btn--on-dark': tone === 'dark' }]} href={href}>{linkLabel} <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></a>}
    </div>
  </div>
</section>
<style>
  .ed { padding-block: var(--space-9); overflow: hidden; }
  @media (min-width: 900px) { .ed { padding-block: 128px; } }
  .ed--dark { background: var(--panel-dark); color: var(--on-panel); }
  .ed--light { background: var(--stone); color: var(--ink); }
  .ed__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-9); align-items: center; }
  .ed--flip .ed__in { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); }
  .ed--flip .ed__media { order: 2; }
  .ed__media { position: relative; }
  /* The big picture breaks the container and runs to the viewport edge */
  .ed__img { aspect-ratio: 5 / 4; overflow: hidden; background: var(--stone); margin-left: calc(-1 * var(--gutter)); }
  @media (min-width: 1360px) { .ed__img { margin-left: calc(-1 * ((100vw - var(--container)) / 2 + var(--gutter))); } }
  .ed--flip .ed__img { margin-left: 0; margin-right: calc(-1 * var(--gutter)); }
  @media (min-width: 1360px) { .ed--flip .ed__img { margin-right: calc(-1 * ((100vw - var(--container)) / 2 + var(--gutter))); } }
  .ed__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* The detail sits over the corner, a step up from the ground */
  .ed__detail { position: absolute; right: -8%; bottom: -14%; width: 38%; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface-raised); box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .ed--flip .ed__detail { right: auto; left: -8%; }
  .ed--light .ed__detail { box-shadow: 0 24px 60px rgba(27,31,38,.18); }
  .ed__detail :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ed__txt { display: flex; flex-direction: column; gap: var(--space-5); padding-top: var(--space-6); position: relative; z-index: 2; }
  .ed__mark { display: flex; align-items: baseline; gap: 18px; }
  /* overlap: the title crosses into the photograph, which melts into the ground beneath it */
  .ed--overlap .ed__img { position: relative; }
  .ed--overlap .ed__img::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 1; background: linear-gradient(to left, var(--stone) 0%, rgba(239,234,226,.6) 16%, rgba(239,234,226,0) 44%); }
  .ed--overlap.ed--flip .ed__img::after { background: linear-gradient(to right, var(--stone) 0%, rgba(239,234,226,.6) 16%, rgba(239,234,226,0) 44%); }
  .ed--overlap.ed--dark .ed__img::after { background: linear-gradient(to left, var(--panel-dark) 0%, rgba(15,17,20,.6) 16%, rgba(15,17,20,0) 44%); }
  .ed--overlap.ed--dark.ed--flip .ed__img::after { background: linear-gradient(to right, var(--panel-dark) 0%, rgba(15,17,20,.6) 16%, rgba(15,17,20,0) 44%); }
  @media (max-width: 900px) { .ed--overlap .ed__img::after { display: none; } }
  @media (min-width: 900px) { .ed--overlap .ed__title { margin-left: -46%; max-width: 700px; } .ed--overlap.ed--flip .ed__title { margin-left: 0; margin-right: -46%; } .ed--overlap .ed__title { font-size: clamp(44px, 5.6vw, 84px); line-height: .96; } }
  .ed__title { font-size: clamp(36px, 4.4vw, 64px); line-height: 1.0; font-weight: 300; letter-spacing: -0.015em; font-variation-settings: 'opsz' 144; max-width: 520px; text-wrap: balance; }
  .ed--dark .ed__title { color: var(--on-panel); }
  .ed--light .ed__title { color: var(--ink); }
  .ed__lead { font-size: 17px; line-height: 1.7; max-width: 400px; }
  .ed--dark .ed__lead { color: #cfd3d9; }
  .ed--light .ed__lead { color: var(--slate); }
  @media (max-width: 900px) {
    .ed__in { grid-template-columns: 1fr; gap: var(--space-7); }
    .ed--flip .ed__media { order: 0; }
    .ed__img, .ed--flip .ed__img { margin: 0 calc(-1 * var(--gutter)); aspect-ratio: 4 / 5; }
    .ed__detail, .ed--flip .ed__detail { right: var(--space-2); left: auto; bottom: -12%; width: 44%; }
    .ed__txt { padding-top: var(--space-5); }
  }
</style>
