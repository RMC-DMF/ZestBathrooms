---
interface Props { steps: { title: string; text: string }[] }
const { steps } = Astro.props;
---
<ol class="proc">
  {steps.map((s, i) => <li><span class="proc__n">{String(i + 1).padStart(2, '0')}</span><div><p class="proc__t">{s.title}</p><p class="proc__d">{s.text}</p></div></li>)}
</ol>
<style>
  .proc { margin: 0; padding: 0; list-style: none; border-top: var(--hairline) solid var(--line); }
  .proc li { display: grid; grid-template-columns: 56px 1fr; gap: var(--space-4); padding: 22px 0; border-bottom: var(--hairline) solid var(--line); }
  .proc__n { font-family: var(--font-display); font-size: 22px; font-weight: 300; color: var(--accent-text); }
  .proc__t { font-weight: 600; font-size: 17px; color: var(--ink); }
  .proc__d { margin-top: 4px; font-size: 15px; color: var(--slate); }
</style>
