---
import Pic from './Pic.astro';
/**
 * Texture — an extreme close-up of a material at full bleed, with almost nothing on it.
 * The scale contrast against the rooms either side of it is the point.
 */
interface Props { image: string; alt: string; caption?: string; line?: string; position?: string; height?: string }
const { image, alt, caption, line, position = '50% 50%', height = 'clamp(420px, 72vh, 760px)' } = Astro.props;
---
<section class="texture z-on-dark" style={`height:${height}`}>
  <div class="texture__img fill"><Pic src={image} alt={alt} class="ken--slow" position={position} sizes="100vw" widths={[768, 1200, 1600, 2000, 2560]} /></div>
  {(caption || line) && <div class="wrap texture__cap">
    {line && <span class="texture__line z-heading">{line}</span>}
    {caption && <span class="texture__caption z-heading">{caption}</span>}
  </div>}
</section>
<style>
  .texture { position: relative; overflow: hidden; background: var(--panel-dark); }
  .texture__img { position: absolute; inset: 0; }
  .texture__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .texture__cap { position: absolute; left: 0; right: 0; bottom: clamp(28px, 4vh, 48px); display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-5); flex-wrap: wrap; }
  .texture__line { font-family: var(--font-display); font-weight: 300; font-size: clamp(26px, 2.6vw, 40px); line-height: 1.05; letter-spacing: -0.01em; font-variation-settings: 'opsz' 144; color: var(--on-panel); text-shadow: 0 1px 2px rgba(0,0,0,.35), 0 10px 40px rgba(0,0,0,.45); max-width: 16ch; }
  .texture__caption { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.72); text-shadow: 0 1px 2px rgba(0,0,0,.5); }
</style>
