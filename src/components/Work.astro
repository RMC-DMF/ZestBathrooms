---
import Pic from './Pic.astro';
/**
 * The work — one dominant project and two supporting, instead of three equal cards.
 * Titles are always visible; hover only moves the photograph.
 */
interface Item { title: string; href: string; image?: string; alt?: string; tags?: string[] }
interface Props { eyebrow: string; title: string; text?: string; items: Item[]; href: string; linkLabel?: string; secondary?: { label: string; href: string } }
const { eyebrow, title, text, items, href, linkLabel = 'All projects', secondary } = Astro.props;
const [lead, ...rest] = items;
---
<section class="work section--loose z-accent--projects z-on-dark">
  <div class="wrap">
    <div class="work__head z-heading">
      <div>
        <span class="z-eyebrow">{eyebrow}</span>
        <h2 class="work__title">{title}</h2>
        {text && <p class="work__lead">{text}</p>}
      </div>
      <div class="cluster work__actions">
        {secondary && <a class="z-btn z-btn--secondary z-btn--on-dark" href={secondary.href}>{secondary.label}</a>}
        <a class="z-btn z-btn--link z-btn--on-dark" href={href}>{linkLabel} <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></a>
      </div>
    </div>
    <div class="work__grid">
      {lead && <a class="work__item work__item--lead" href={lead.href}>
        <div class="work__media fill"><Pic src={lead.image} alt={lead.alt ?? lead.title} sizes="(max-width: 900px) 100vw, 58vw" widths={[640, 960, 1280, 1600]} /></div>
        <div class="work__cap"><span class="work__tags">{(lead.tags ?? []).join(' · ')}</span><h3>{lead.title}</h3></div>
      </a>}
      {rest.slice(0, 2).map((p) => <a class="work__item" href={p.href}>
        <div class="work__media fill"><Pic src={p.image} alt={p.alt ?? p.title} sizes="(max-width: 900px) 100vw, 40vw" widths={[480, 768, 1024]} /></div>
        <div class="work__cap"><span class="work__tags">{(p.tags ?? []).join(' · ')}</span><h3>{p.title}</h3></div>
      </a>)}
    </div>
  </div>
</section>
<style>
  .work__head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-6); margin-bottom: var(--space-7); flex-wrap: wrap; }
  .work__title { font-size: clamp(34px, 4.2vw, 60px); line-height: 1.02; font-weight: 300; letter-spacing: -0.012em; font-variation-settings: 'opsz' 144; max-width: 640px; color: var(--on-panel); }
  .work__lead { margin-top: var(--space-4); max-width: 520px; font-size: 17px; line-height: 1.7; color: #cfd3d9; }
  .work__actions { gap: 28px; }
  .work__grid { display: grid; grid-template-columns: 7fr 5fr; grid-template-rows: 1fr 1fr; gap: var(--space-5); }
  .work__item { display: flex; flex-direction: column; gap: 18px; text-decoration: none; color: inherit; min-width: 0; }
  .work__item--lead { grid-row: 1 / 3; }
  .work__media { position: relative; overflow: hidden; background: var(--surface-raised); flex: 1 1 auto; min-height: 0; }
  .work__item--lead .work__media { aspect-ratio: 5 / 4; }
  .work__item:not(.work__item--lead) .work__media { aspect-ratio: auto; }
  .work__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .work__item:hover .work__media :global(img) { transform: scale(1.03); }
  .work__cap { display: flex; flex-direction: column; gap: 6px; }
  .work__tags { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-text); }
  .work__cap h3 { font-size: 22px; font-weight: 400; line-height: 1.2; color: var(--on-panel); }
  .work__item--lead .work__cap h3 { font-size: clamp(24px, 2.4vw, 32px); font-weight: 300; }
  @media (max-width: 900px) {
    .work__grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .work__item--lead { grid-row: auto; }
    .work__item:not(.work__item--lead) .work__media { aspect-ratio: 3 / 2; }
  }
</style>
