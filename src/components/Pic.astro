---
/**
 * Optimised picture. Pass a content path (/images/...) and it renders <Picture> with AVIF/WebP and a srcset;
 * anything not under src/assets falls back to a plain <img>, and no src renders a stone placeholder.
 */
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';
interface Props { src?: string; alt: string; widths?: number[]; sizes?: string; priority?: boolean; class?: string; style?: string; aspect?: string; position?: string }
const { src, alt, widths = [480, 768, 1024, 1440, 1920], sizes = '100vw', priority = false, class: cls = '', style = '', aspect, position } = Astro.props;
const meta = await resolveImage(src);
const styleAttr = [style, aspect ? `aspect-ratio:${aspect}` : '', position ? `object-position:${position}` : ''].filter(Boolean).join(';');
const ws = meta ? [...new Set(widths.filter((w) => w < meta.width).concat(meta.width))] : widths;
---
{meta ? (
  <Picture src={meta} alt={alt} widths={ws} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg" quality={78} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding={priority ? 'sync' : 'async'} class={cls} style={styleAttr || undefined} pictureAttributes={{ class: 'pic' }} />
) : src ? (
  <img src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" class={cls} style={styleAttr || undefined} />
) : (
  <div class:list={['pic-ph', cls]} style={styleAttr || undefined} aria-hidden="true"></div>
)}
<style is:global>
  .pic { display: contents; }
  .pic-ph { background: var(--stone); width: 100%; height: 100%; }
</style>
