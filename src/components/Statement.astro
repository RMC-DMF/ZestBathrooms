---
/** One centred sentence in Fraunces with room to breathe. */
---
<section class="statement wrap">
  <p class="statement__p"><slot /></p>
</section>
<style>
  .statement { padding: 176px var(--gutter) 144px; }
  .statement__p { margin: 0 auto; max-width: 880px; text-align: center; font-family: var(--font-display); font-size: clamp(28px, 3vw, 40px); line-height: 1.25; font-weight: 300; font-variation-settings: 'opsz' 72; color: var(--on-panel); }
  @media (max-width: 900px) { .statement { padding: 96px var(--gutter) 80px; } }
</style>
