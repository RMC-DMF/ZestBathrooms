---
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { site } from '../data/site';
import type { Accent } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Section accent applied to the whole page. */
  accent?: Accent;
  /** Dark ground — the default. Pass dark={false} only for a deliberately light page. */
  dark?: boolean;
  /** Header floats over the first section (full-screen hero). */
  floatingHeader?: boolean;
  ogImage?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  canonical?: string;
}
const { title, description, accent = 'neutral', dark = true, floatingHeader = false, ogImage, schema = [], noindex = false, canonical } = Astro.props;
// Keep titles inside ~65 characters: use the longest brand suffix that fits
const fullTitle = title.includes('Zest') ? title : ([' | Zest Bathrooms & Kitchens, Chester', ' | Zest Bathrooms & Kitchens', ' | Zest Chester', ' | Zest'].map((x) => title + x).find((t) => t.length <= 65) ?? `${title} | Zest`);
// Descriptions over 160 characters are cut at the last full sentence (or word) that fits
const metaDescription = description.length <= 160 ? description : (() => { const cut = description.slice(0, 158); const stop = cut.lastIndexOf('. '); return stop > 90 ? cut.slice(0, stop + 1) : cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:—–-]\s*$/, '') + '…'; })();
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1') || '/';
const canonicalUrl = canonical ?? new URL(cleanPath, site.url).href;
// Social preview: the page's own hero, cropped to 1200×630; the default card only when a page has no picture
const ogMeta = await resolveImage(ogImage);
const ogSrc = ogMeta ? (await getImage({ src: ogMeta, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src : ogImage;
const og = new URL((ogSrc && ogSrc.includes('/.netlify/images') && !ogSrc.includes('fit=') ? ogSrc + '&fit=cover' : ogSrc) ?? '/images/og-default.jpg', site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HomeGoodsStore'],
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  telephone: '+441244345414',
  email: site.email,
  foundingDate: String(site.founded),
  image: og,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lng },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '16:00' },
  ],
  areaServed: site.areas.map((a) => ({ '@type': 'Place', name: a.replace(/^the /, '') })),
  sameAs: Object.values(site.social),
  department: {
    '@type': 'LocalBusiness',
    name: `${site.name} — ${site.projectsOffice.name}`,
    telephone: '+441925269517',
    address: { '@type': 'PostalAddress', streetAddress: site.projectsOffice.street, addressLocality: site.projectsOffice.locality, postalCode: site.projectsOffice.postcode, addressCountry: site.projectsOffice.country },
  },
};
const crumbNames: Record<string, string> = { 'case-studies': 'Case studies', 'design-service': 'Design service', 'about': 'About', 'areas': 'Areas', 'brands': 'Brands', 'journal': 'Journal', 'kitchens': 'Kitchens', 'bathrooms': 'Bathrooms', 'projects': 'Projects' };
const breadcrumbs = (() => {
  const parts = cleanPath.split('/').filter(Boolean);
  if (!parts.length) return null;
  const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url }];
  parts.forEach((p, i) => items.push({ '@type': 'ListItem', position: i + 2, name: i === parts.length - 1 ? title.split(' | ')[0] : (crumbNames[p] ?? p.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())), item: `${site.url}/${parts.slice(0, i + 1).join('/')}` }));
  return { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items };
})();
---
<!doctype html>
<html lang="en-GB" data-theme={dark ? 'dark' : 'light'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content={dark ? '#0f1114' : '#faf8f5'} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class:list={['z-root', `z-accent--${accent}`, { dark }]}>
    <a class="skip" href="#main">Skip to content</a>
    <Header floating={floatingHeader} dark={dark || floatingHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <script>
      // Scroll reveal — one gentle rise per element, never repeated, off for reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const sel = 'main .fill, main .feat__img, main .row__img, main .gal__item, main .design__img, main .z-heading, main .z-case, main .z-person, main .kf__item, main .proc li, main .feat__txt, main .row__txt, main .statement__p, main .z-fact, main .post, main .coll, main .ed__img, main .ed__detail, main .ed__txt';
        const els = Array.from(document.querySelectorAll<HTMLElement>(sel)).filter((el) => !el.closest('[data-no-reveal], .hero, .page-head, .study-head, .bh, .bleed'));
        const maskSel = '.fill, .feat__img, .row__img, .gal__item, .design__img, .ed__img, .ed__detail';
        els.forEach((el) => el.classList.add(el.matches(maskSel) ? 'reveal--mask' : 'reveal'));
        // With scroll-driven animations the CSS does the work from the scroll position; the observer only matters as the fallback,
        // where it fires a little before the element enters so the short transition is over by the time it is seen.
        const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px 12% 0px', threshold: 0 });
        els.forEach((el) => io.observe(el));
        // Safety nets: anything already on screen shows at once; everything shows after 2.5s regardless.
        requestAnimationFrame(() => els.forEach((el) => { if (el.getBoundingClientRect().top < innerHeight) el.classList.add('is-in'); }));
        setTimeout(() => els.forEach((el) => el.classList.add('is-in')), 2500);
      }
    </script>
    <!-- Analytics: GA4 via a delayed loader, only after consent. See src/components/Analytics.astro once the consent tool is chosen. -->
    <script>
      // Form guard: drop submissions sent within 3s of page load (scripts, not people), and flag likely sales pitches in the email subject. Nothing genuine is blocked.
      const loaded = Date.now();
      const pitch = /(https?:\/\/|www\.|\.(com|io|net|ai)\b|promo ?code|\bUSD\b|\$\d|backlink|\bSEO\b|guest post|free trial|no charge|sign ?up at|our (agency|plugin|platform|software)|wordpress)/i;
      document.querySelectorAll<HTMLFormElement>('form[data-netlify]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          if (Date.now() - loaded < 3000) { e.preventDefault(); location.href = form.getAttribute('action') || '/thank-you'; return; }
          const subject = form.querySelector<HTMLInputElement>('[data-subject]');
          const text = [...form.querySelectorAll<HTMLTextAreaElement>('textarea')].map((t) => t.value).join(' ');
          if (subject && pitch.test(text) && !subject.value.startsWith('[Check')) subject.value = `[Check: possible sales pitch] ${subject.value}`;
        });
      });
    </script>
  </body>
</html>
