---
import Pic from '../components/Pic.astro';
/** Case study and project layout. */
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import PersonCard from '../components/PersonCard.astro';
import type { Accent } from '../data/site';
import { getEntry } from 'astro:content';
interface Props { title: string; description: string; accent: Accent; eyebrow: string; hero?: { src: string; alt: string }; gallery?: { src: string; alt: string }[]; facts: { label: string; value?: string | number }[]; quote?: { text: string; by: string }; designer?: string; brands?: string[]; cta?: { label?: string; href?: string; title?: string; text?: string }; related?: { title: string; href: string; image?: string; meta?: string }[] }
const { title, description, accent, eyebrow, hero, gallery = [], facts, quote, designer, brands = [], cta = {}, related = [] } = Astro.props;
const person = designer ? await getEntry('team', designer) : undefined;
const brandEntries = (await Promise.all(brands.map((b) => getEntry('brands', b)))).filter(Boolean);
---
<Base title={title} description={description} accent={accent}>
  <article>
    <header class="study-head">
      {hero && <Pic src={hero.src} alt={hero.alt} class="study-head__img ken--slow" priority sizes="100vw" widths={[768, 1200, 1600, 2000]} />}
      {hero && <div class="study-head__shade head-shade" aria-hidden="true"></div>}
      <div class="wrap z-heading z-on-dark" style="position:relative">
        <span class="z-eyebrow rise q1">{eyebrow}</span>
        <h1 class="z-heading__title z-heading__title--display rise q2">{title}</h1>
      </div>
    </header>
    <div class="wrap study">
      <aside class="study__facts">
        <dl>
          {facts.filter((f) => f.value).map((f) => <div><dt>{f.label}</dt><dd>{String(f.value)}</dd></div>)}
          {brandEntries.length > 0 && <div><dt>Brands</dt><dd>{brandEntries.map((b, i) => <>{i > 0 && ', '}<a href={`/brands/${b!.id}`}>{b!.data.title}</a></>)}</dd></div>}
        </dl>
        {person && <PersonCard name={person.data.name} role={person.data.role} photo={person.data.photo} ask={person.data.ask} contactHref={person.data.email ? `mailto:${person.data.email}` : undefined} contactLabel={person.data.email ? `Email ${person.data.name.split(' ')[0]}` : undefined} />}
      </aside>
      <div class="study__body prose">
        <slot />
        {quote && <blockquote>{quote.text}<footer class="caption" style="margin-top:12px">— {quote.by}</footer></blockquote>}
      </div>
    </div>
    {gallery.length > 0 && <section class="wrap study__gallery">
      {gallery.map((g, i) => <figure class:list={{ wide: i % 3 === 0 }}><Pic src={g.src} alt={g.alt || `${title} — photograph ${i + 2}`} sizes={i % 3 === 0 ? '(max-width: 1280px) 100vw, 1280px' : '(max-width: 900px) 100vw, 50vw'} widths={[480, 768, 1024, 1440, 1920]} /></figure>)}
    </section>}
    {related.length > 0 && <section class="wrap section">
      <div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">More like this</span><h2>Related work</h2></div>
      <div class="grid grid--3">
        {related.map((r) => <a class="z-case" href={r.href} style="max-width:none"><div class="z-case__media"><Pic src={r.image} alt="" sizes="(max-width: 900px) 100vw, 33vw" widths={[400, 640, 900]} /></div><div class="z-case__body">{r.meta && <p class="caption" style="margin-bottom:8px">{r.meta}</p>}<h3 class="z-case__title">{r.title}</h3></div></a>)}
      </div>
    </section>}
  </article>
  <CtaBand {...cta} />
</Base>
<style>
  .study-head { position: relative; min-height: 88vh; display: flex; align-items: flex-end; background: var(--panel-dark); overflow: hidden; padding: 200px 0 var(--space-8); }
  .study-head .z-heading { max-width: none; }
  .study-head .z-heading__title { font-size: clamp(40px, 5vw, 72px); line-height: .98; letter-spacing: -0.015em; max-width: 980px; }
  .study-head__img, .study-head :global(.pic img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .study-head__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,17,20,.85) 0%, rgba(15,17,20,.2) 60%, rgba(15,17,20,.15) 100%); }
  .study-head .z-heading__title { color: var(--on-panel); max-width: 900px; }
  .study { display: grid; grid-template-columns: 320px 1fr; gap: var(--space-9); padding-block: var(--space-9); }
  .study__facts dl { margin: 0 0 var(--space-6); border-top: var(--hairline) solid var(--line); }
  .study__facts dl > div { display: grid; grid-template-columns: 110px 1fr; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: var(--hairline) solid var(--line); font-size: 15px; }
  .study__facts dt { color: var(--slate-muted); }
  .study__facts dd { margin: 0; color: var(--ink); }
  .study__body { font-size: 18px; line-height: 1.7; }
  .study__gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); padding-bottom: var(--space-8); }
  .study__gallery figure { margin: 0; }
  .study__gallery figure.wide { grid-column: 1 / -1; }
  .study__gallery :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .study__gallery figure.wide :global(img) { aspect-ratio: 16 / 9; }
  @media (max-width: 900px) { .study { grid-template-columns: 1fr; gap: var(--space-7); } .study__gallery { grid-template-columns: 1fr; } }
</style>
