---
import Pic from '../components/Pic.astro';
/** Light content page: eyebrow / title / lead header, then slot, then the CTA band. */
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Accent } from '../data/site';
interface Props { title: string; description: string; eyebrow?: string; heading?: string; lead?: string; accent?: Accent; hero?: { src: string; alt: string }; cta?: { title?: string; text?: string; label?: string; href?: string } | false; schema?: Record<string, unknown>[]; noindex?: boolean }
const { title, description, eyebrow, heading, lead, accent = 'neutral', hero, cta = {}, schema, noindex } = Astro.props;
---
<Base title={title} description={description} accent={accent} schema={schema} noindex={noindex}>
  <header class:list={['page-head', { 'page-head--img': hero }]}>
    {hero && <Pic src={hero.src} alt={hero.alt} class="page-head__img ken--slow" priority sizes="100vw" widths={[768, 1200, 1600, 2000]} />}
    {hero && <div class="page-head__shade head-shade" aria-hidden="true"></div>}
    <div class:list={['wrap', 'z-heading', { 'z-on-dark': hero }]}>
      {eyebrow && <span class:list={["z-eyebrow", { "rise q1": hero }]}>{eyebrow}</span>}
      <h1 class:list={["z-heading__title z-heading__title--display", { "rise q2": hero }]}>{heading ?? title}</h1>
      {lead && <p class:list={["z-heading__lead", { "rise q3": hero }]}>{lead}</p>}
    </div>
  </header>
  <slot />
  {cta !== false && <CtaBand {...cta} />}
</Base>
<style>
  .page-head { padding: var(--space-8) 0 var(--space-7); }
  @media (min-width: 900px) { .page-head { padding: var(--space-9) 0 var(--space-8); } }
  .page-head .z-heading { max-width: var(--container); }
  .page-head .z-heading__title { max-width: 820px; }
  .page-head .z-heading__lead { max-width: 640px; }
  .page-head--img { position: relative; min-height: 86vh; display: flex; align-items: flex-end; background: var(--panel-dark); overflow: hidden; padding-top: 200px; padding-bottom: var(--space-8); }
  .page-head--img .z-heading__title { font-size: clamp(44px, 5.6vw, 80px); line-height: .96; letter-spacing: -0.015em; }
  .page-head--img .z-heading__lead { font-size: 19px; opacity: .9; }
  .page-head__img, .page-head :global(.pic img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-head__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,17,20,.82) 0%, rgba(15,17,20,.25) 55%, rgba(15,17,20,.2) 100%); }
  .page-head--img .z-heading { position: relative; width: 100%; }
  .page-head--img .z-heading__title, .page-head--img .z-heading__lead { color: var(--on-panel); }
</style>
