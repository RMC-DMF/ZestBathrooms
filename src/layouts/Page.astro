---
import Pic from '../components/Pic.astro';
/** Light content page: eyebrow / title / lead header, then slot, then the CTA band. */
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Accent } from '../data/site';
interface Props { title: string; description: string; eyebrow?: string; heading?: string; lead?: string; accent?: Accent; hero?: { src: string; alt: string; mobile?: string }; cta?: { title?: string; text?: string; label?: string; href?: string } | false; schema?: Record<string, unknown>[]; noindex?: boolean }
const { title, description, eyebrow, heading, lead, accent = 'neutral', hero, cta = {}, schema, noindex } = Astro.props;
---
<Base title={title} description={description} accent={accent} schema={schema} noindex={noindex}>
  <header class:list={['page-head', { 'page-head--img': hero }]}>
    {hero && <div class="page-head__pic" style={accent !== 'neutral' ? `view-transition-name:${accent}-head` : undefined}><Pic src={hero.src} mobile={hero.mobile} alt={hero.alt} class="page-head__img ken--slow" priority sizes="100vw" widths={[768, 1200, 1600, 2000]} /><div class="page-head__shade head-shade" aria-hidden="true"></div>{eyebrow && <div class="wrap page-head__mark"><span class="z-eyebrow rise q1">{eyebrow}</span></div>}</div>}
    <div class:list={['wrap', 'z-heading', 'page-head__copy']}>
      {eyebrow && !hero && <span class="z-eyebrow">{eyebrow}</span>}
      <h1 class:list={["z-heading__title z-heading__title--display", { "rise q2": hero }]}>{heading ?? title}</h1>
      {lead && <p class:list={["z-heading__lead", { "rise q3": hero }]}>{lead}</p>}
    </div>
  </header>
  <slot />
  {cta !== false && <CtaBand {...cta} />}
</Base>
<style>
  .page-head { padding: var(--space-8) 0 var(--space-7); }
  @media (min-width: 900px) { .page-head { padding: var(--space-9) 0 var(--space-8); } }
  .page-head .z-heading { max-width: var(--container); }
  .page-head .z-heading__title { max-width: 820px; }
  .page-head .z-heading__lead { max-width: 640px; }
  /* Photographic head: the picture is a full-width block and the title breaks out of its bottom edge */
  .page-head--img { padding: 0 0 clamp(48px, 6vw, 88px); background: var(--panel-dark); }
  .page-head__pic { position: relative; height: clamp(440px, 64vh, 720px); overflow: hidden; background: var(--panel-dark); }
  .page-head__img, .page-head__pic :global(.pic img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-head__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,17,20,.78) 0%, rgba(15,17,20,.18) 48%, rgba(15,17,20,.2) 100%); }
  .page-head__mark { position: absolute; left: 0; right: 0; bottom: clamp(88px, 6.4vw, 112px); }
  .page-head__mark .z-eyebrow { color: var(--on-panel); }
  .page-head__mark .z-eyebrow::after { background: var(--on-panel); opacity: .6; }
  .page-head--img .page-head__copy { position: relative; z-index: 1; }
  .page-head--img .z-heading__title { margin-top: -0.5em; max-width: 13ch; font-size: clamp(48px, 8.2vw, 128px); line-height: .92; letter-spacing: -0.025em; color: var(--on-panel); text-shadow: 0 2px 4px rgba(0,0,0,.25), 0 16px 48px rgba(0,0,0,.35); text-wrap: balance; }
  .page-head--img .z-heading__lead { margin-top: var(--space-5); font-size: 19px; color: #cfd3d9; max-width: 520px; }
  @media (min-width: 900px) { .page-head--img .z-heading__lead { margin-left: clamp(0px, 22vw, 440px); } }
  @media (max-width: 900px) { .page-head__pic { height: 62svh; } .page-head__mark { bottom: 64px; } .page-head--img .z-heading__title { font-size: clamp(44px, 13vw, 68px); max-width: 10ch; } .page-head--img { padding-bottom: 40px; } }
</style>
