---
import { sections } from '../../data/site';
import Page from '../../layouts/Page.astro';
import Feature from '../../components/Feature.astro';
import Editorial from '../../components/Editorial.astro';
import FullBleed from '../../components/FullBleed.astro';
import Gallery from '../../components/Gallery.astro';
import Work from '../../components/Work.astro';
import Texture from '../../components/Texture.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection } from 'astro:content';
import imgs from '../../data/page-images.json';
import { site } from '../../data/site';
const studies = (await getCollection('caseStudies', ({ data }) => data.room === 'kitchens' && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const details = [
  { src: '/images/case-studies/kitchens/walnut-porcelain-kitchen-07.webp', alt: 'Open SieMatic drawer in a walnut island, garden beyond' },
  { src: '/images/case-studies/kitchens/dark-timber-sea-view-kitchen-07.webp', alt: 'Downdraft induction hob set into a porcelain island top' },
  { src: '/images/case-studies/kitchens/walnut-porcelain-kitchen-09.webp', alt: 'Wine column and larder in walnut tall units' },
  { src: '/images/case-studies/kitchens/oak-bar-kitchen-02.webp', alt: 'Velvet bar stools under a raised dark oak breakfast bar' },
  { src: '/images/case-studies/kitchens/dark-timber-sea-view-kitchen-06.webp', alt: 'Two Gaggenau ovens in dark timber tall units, antiqued mirror splashback' },
  { src: '/images/showroom/siematic-display-marble-island-and-bronze-tall-units-zest-showroom.webp', alt: 'SieMatic display with a marble waterfall island and bronze tall units, Zest showroom' },
  { src: '/images/case-studies/kitchens/walnut-porcelain-kitchen-05.webp', alt: 'Walnut pantry dresser with open shelving' },
];
const faqs = [
  { q: 'What does a SieMatic kitchen cost?', a: 'It depends on the size of the room, the worktop and the appliances more than on the furniture itself, so we price from a specification rather than a list. Come in with your plans or your measurements and we will give you a realistic budget range at the first appointment, before any design work starts.' },
  { q: 'Which kitchens do you sell?', a: 'SieMatic first: four displays on the floor in Chester, with Gaggenau, Miele, Siemens, Bora and Quooker built in. For a classic painted kitchen — shaker, in-frame looks, colour to order — we design with Burbidge, made in Coventry by the same family since 1867.' },
  { q: 'Do you install?', a: 'We supply and project-manage, and work with a small group of installers we have used for years. You can use your own installer too.' },
  { q: 'How long does it take?', a: 'SieMatic kitchens are made to order in Germany, so the lead time runs from the day the specification is signed off. We confirm the current factory lead time when we design, and plan the survey, delivery and installation around it so nothing arrives before the room is ready.' },
];
---
<Page sections={sections.kitchens} title="Luxury SieMatic Kitchens Chester" description="SieMatic kitchens designed and supplied from Chester for homes across Cheshire, the Wirral, North Wales and the North West. See the displays in our showroom." accent="kitchens" eyebrow="Kitchens — Chester" heading="The kitchen, planned properly." lead="SieMatic, specified by our own studio around how you actually cook, eat and gather — every detail of the room considered before a single unit is ordered." hero={{ src: '/images/case-studies/kitchens/dark-timber-sea-view-kitchen-01.webp', mobile: '/images/mobile/dark-timber-sea-view-kitchen-01-portrait.jpg', alt: 'Dark timber SieMatic kitchen with a taupe island, sea view through full-height glazing — designed by Zest' }}>
  <Texture image="/images/case-studies/kitchens/dark-timber-sea-view-kitchen-08.webp" alt="Open SieMatic drawers with cutlery inserts and stacked dishes" line="One range. Known inside out." caption="SieMatic — Löhne, Germany, since 1929" />
  <Feature image={imgs.siematic.collections.pure} alt="SieMatic Pure kitchen" eyebrow="The range" title="SieMatic, at the heart of it.">
    <p>The handleless original since 1960, in four design languages: Pure, Urban, Classic and Mondial. Made in Löhne by a family firm in its third generation, and sold only through appointed studios like ours.</p>
    <p>SieMatic is the kitchen we lead with. Four displays in the showroom, with Gaggenau, Miele, Siemens, Bora and Quooker built in, so you see the appliances in the cabinetry rather than on a shelf.</p>
    <div class="cluster"><a class="z-btn z-btn--secondary" href="/kitchens/siematic">Explore SieMatic</a></div>
  </Feature>
  <Feature image="/images/brands/press/burbidge-sage-green-shaker-kitchen-with-oak-floor.jpg" alt="Burbidge shaker kitchen in sage green with a range cooker" eyebrow="Classic kitchens" title="Burbidge, for the painted kitchen." flip>
    <p>For a traditional room — painted shaker, in-frame looks, a dresser or a larder in a colour chosen for the house — we design with Burbidge, made in Coventry by the same family since 1867.</p>
    <p>Same designers, same free design service. The contemporary side is SieMatic; the classic side is Burbidge.</p>
    <div class="cluster"><a class="z-btn z-btn--secondary" href="/brands/burbidge">Explore Burbidge</a></div>
  </Feature>
  <Work accent="kitchens" eyebrow="Recent kitchens" title="Designed in Chester, fitted across the North West." href="/kitchens/case-studies" linkLabel={`All ${studies.length} kitchen case studies`} items={studies.slice(0, 3).map((s) => ({ title: s.data.title, href: `/kitchens/case-studies/${s.id.split('/').pop()}`, image: s.data.hero?.src, alt: s.data.hero?.alt, tags: [s.data.kind ?? 'Kitchen', s.data.location?.split(',')[0], s.data.designer && `Designed by ${s.data.designer}`].filter(Boolean) as string[] }))} />
  <Editorial overlap tone="light" accent="kitchens" image="/images/pages/black-tempest-stone-worktop-and-smoked-oak-siematic-units-zest.jpg" alt="The 2026 SieMatic display in graphite smoked oak with a Black Tempest stone island, Zest showroom" detail="/images/pages/smoked-oak-siematic-fronts-with-a-brass-light-channel-close-up.webp" detailAlt="Smoked-oak SieMatic drawer fronts with a brass light channel, close up" position="50% 50%" eyebrow="The process" title="One studio, from the first sketch to the last handle." text="The design service is free: an hour in the showroom, a survey, then layouts, 3D visuals and a specification with every product named — before anything is ordered. The people who drew it stay involved through installation." href="/design-service" linkLabel="How it works" />
  <FullBleed accent="kitchens" image="/images/pages/our-showroom-67.webp" alt="SieMatic island with a grey stone worktop and leather bar stools, Zest showroom" position="50% 60%" eyebrow="The showroom" title="Four SieMatic kitchens, on the floor in Chester." text="Stand in them, open the drawers, see Gaggenau and Miele built into the runs. The quickest way to know what you want is an hour among the real thing." cta={{ label: 'Plan a visit', href: '/about/showroom' }} minHeight="80vh" shade="left" />
  <Gallery images={details} max={6} eyebrow="Details" title="The parts you touch every day." />
  <Feature image={imgs.siematic.collections.urban} alt="SieMatic Urban kitchen" eyebrow="Money" title="What a kitchen costs, before you book." tone="stone">
    <p>Ranges, not quotes — but real ones, from kitchens we have designed and fitted, and an honest account of what moves the number.</p>
    <div class="cluster"><a class="z-btn z-btn--link" href="/kitchens/brochures">Request brochures <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></a></div>
  </Feature>
  <section class="wrap section"><div style="max-width:720px"><div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">Questions</span><h2>Before you book</h2></div><FAQ items={faqs} openFirst /></div></section>
</Page>
