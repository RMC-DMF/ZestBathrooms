---
import Page from '../../layouts/Page.astro';
import Feature from '../../components/Feature.astro';
import Editorial from '../../components/Editorial.astro';
import FullBleed from '../../components/FullBleed.astro';
import Gallery from '../../components/Gallery.astro';
import Work from '../../components/Work.astro';
import Texture from '../../components/Texture.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection } from 'astro:content';
import imgs from '../../data/page-images.json';
import { site } from '../../data/site';
const studies = (await getCollection('caseStudies', ({ data }) => data.room === 'kitchens' && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const faqs = [
  { q: 'What does a SieMatic kitchen cost?', a: 'Most SieMatic kitchens we design fall between [£X] and [£X] including appliances and worktops; our <a href="/kitchens/cost-guide">cost guide</a> explains what moves the number.' },
  { q: 'Do you only sell SieMatic?', a: 'Yes. Four SieMatic displays on the floor in Chester, with Gaggenau, Miele, Siemens, Bora and Quooker alongside. One range, known inside out, is how we keep the design and the installation right.' },
  { q: 'Do you install?', a: 'We supply and project-manage, and work with a small group of installers we have used for years. You can use your own installer too.' },
  { q: 'How long does it take?', a: 'Design typically takes [X] weeks from first appointment to signed-off specification; SieMatic lead times are [X] weeks from order; installation [X] weeks.' },
];
---
<Page title="Luxury SieMatic Kitchens Chester" description="SieMatic kitchens designed and supplied from Chester for homes across Cheshire, the Wirral, North Wales and the North West. See the displays in our showroom." accent="kitchens" eyebrow="Kitchens — Chester" heading="The kitchen, planned properly." lead="SieMatic, specified by our own studio around how you actually cook, eat and gather — every detail of the room considered before a single unit is ordered." hero={{ src: '/images/home/kitchen-abbotts.jpg', mobile: '/images/mobile/kitchen-abbotts-portrait.jpg', alt: 'SieMatic kitchen with island and pantry, Abbot\'s Bank, Cheshire — designed by Zest' }}>
  <Texture image="/images/journal/luxury-kitchen-trends-2026-what-high-end-clients-really-want-03.webp" alt="Brass handle on dark lacquered SieMatic cabinetry, close up" line="One range. Known inside out." caption="SieMatic — Löhne, Germany, since 1929" />
  <Feature image={imgs.siematic.collections.pure} alt="SieMatic Pure kitchen" eyebrow="The range" title="SieMatic, and nothing else.">
    <p>The handleless original since 1960, in four design languages: Pure, Urban, Classic and Mondial. Made in Löhne by a family firm in its third generation, and sold only through appointed studios like ours.</p>
    <p>We sell one kitchen range on purpose. Four SieMatic displays in the showroom, with Gaggenau, Miele, Siemens, Bora and Quooker built in, so you see the appliances in the cabinetry rather than on a shelf.</p>
    <div class="cluster"><a class="z-btn z-btn--secondary" href="/kitchens/siematic">Explore SieMatic</a></div>
  </Feature>
  <Work accent="kitchens" eyebrow="Recent kitchens" title="Designed in Chester, fitted across the North West." href="/kitchens/case-studies" linkLabel={`All ${studies.length} kitchen case studies`} items={studies.slice(0, 3).map((s) => ({ title: s.data.title, href: `/kitchens/case-studies/${s.id.split('/').pop()}`, image: s.data.hero?.src, alt: s.data.hero?.alt, tags: ['Kitchen', s.data.location?.split(',')[0], s.data.designer && `Designed by ${s.data.designer}`].filter(Boolean) as string[] }))} />
  <Editorial overlap tone="light" accent="kitchens" image="/images/pages/introducing-our-new-siematic-display-02.jpg" alt="The 2026 SieMatic display in graphite smoked oak with a Black Tempest stone island, Zest showroom" detail="/images/pages/introducing-our-new-siematic-display-07.webp" detailAlt="Smoked-oak SieMatic drawer fronts with a brass light channel, close up" position="50% 50%" eyebrow="The process" title="One designer, first sketch to last handle." text="The design service is free: an hour in the showroom, a survey, then layouts, 3D visuals and a specification with every product named — before anything is ordered. The same designer sees it through installation." href="/design-service" linkLabel="How it works" />
  <FullBleed accent="kitchens" image="/images/pages/our-showroom-67.webp" alt="SieMatic island with a grey stone worktop and leather bar stools, Zest showroom" position="50% 60%" eyebrow="The showroom" title="Four SieMatic kitchens, on the floor in Chester." text="Stand in them, open the drawers, see Gaggenau and Miele built into the runs. The quickest way to know what you want is an hour among the real thing." cta={{ label: 'Plan a visit', href: '/about/showroom' }} minHeight="80vh" shade="left" />
  <Gallery images={imgs.kitchenLife.map((src: string) => ({ src }))} max={5} eyebrow="Details" title="The parts you touch every day." />
  <Feature image={imgs.siematic.collections.urban} alt="SieMatic Urban kitchen" eyebrow="Money" title="What a kitchen costs, before you book." tone="stone">
    <p>Ranges, not quotes — but real ones, from kitchens we have designed and fitted, and an honest account of what moves the number.</p>
    <div class="cluster"><a class="z-btn z-btn--secondary" href="/kitchens/cost-guide">Read the cost guide</a><a class="z-btn z-btn--link" href="/kitchens/brochures">Request brochures <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></a></div>
  </Feature>
  <section class="wrap section"><div style="max-width:720px"><div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">Questions</span><h2>Before you book</h2></div><FAQ items={faqs} openFirst /></div></section>
</Page>
