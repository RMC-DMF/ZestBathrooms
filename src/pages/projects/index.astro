---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import FactStrip from '../../components/FactStrip.astro';
import Work from '../../components/Work.astro';
import Pic from '../../components/Pic.astro';
import ProcessList from '../../components/ProcessList.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => (b.data.units ?? 0) - (a.data.units ?? 0) || b.data.date.valueOf() - a.data.date.valueOf());
const units = projects.reduce((n, p) => n + (p.data.units ?? 0), 0);
const clients = [...new Set(projects.map((p) => p.data.client).filter(Boolean))];
const steps = [
  { title: 'Register the project', text: 'Scheme, location, unit count, stage. We come back within one working day.' },
  { title: 'Specification support', text: 'Product selection to budget and brief, samples, O&M-ready documentation.' },
  { title: 'Sample room and sign-off', text: 'A full bathroom or kitchen set built to the specification for client approval.' },
  { title: 'Programme-led supply', text: 'Call-off deliveries to site by floor or phase, with a named account contact.' },
  { title: 'Aftercare', text: 'Spares, replacements and warranty handled by the same team.' },
];
---
<Base title="Bathroom & Kitchen Supply for Developers and Hotels" description={`Specification and supply of bathrooms and kitchens for residential developments, hotels and student schemes across the UK. ${units.toLocaleString()} units supplied across ${projects.length} developments, from Chester.`} accent="projects" dark floatingHeader>
  <Hero image="/images/home/project-deansgate.jpg" alt="Deansgate Square towers, Manchester" eyebrow="Projects — developers, architects, hospitality" title="Behind the biggest schemes." text="Bathroom and kitchen specification and supply for residential towers, retirement living, hotels and commercial fit-outs across the UK — thousands of units a year, run from our Warrington project office." cta={site.tradeCta} link={{ label: 'How we work', href: '/projects/how-we-work' }} position="50% 30%" height="88vh" />
  <section class="z-on-dark"><FactStrip dark facts={[{ value: units.toLocaleString(), label: 'Units supplied across the published projects' }, { value: String(projects.length), label: 'Developments and hotels' }, { value: String(clients.length), label: 'Developer and operator clients' }, { value: 'UK', label: 'Manchester, Liverpool, London, Birmingham, Bristol, Surrey' }]} /></section>
  <Work accent="projects" eyebrow="The work" title={`${projects.length} developments, by scale.`} text={`${units.toLocaleString()} units across residential towers, retirement living, hotels and student schemes — specified, sampled and supplied to programme from the Warrington project office.`} href="#index" linkLabel="The full index" secondary={site.tradeCta} items={projects.slice(0, 3).map((p) => ({ title: p.data.title, href: `/projects/${p.id}`, image: p.data.hero?.src, alt: p.data.hero?.alt, tags: [p.data.sector, p.data.location?.split(',')[0], p.data.unitsLabel ?? (p.data.units && `${p.data.units.toLocaleString()} units`)].filter(Boolean) as string[] }))} />
  <section id="index" class="wrap section z-on-dark">
    <div class="z-heading pidx__head"><span class="z-eyebrow">Index</span><h2>Every published project.</h2></div>
    <ol class="pidx">{projects.map((p, i) => <li class="pidx__row z-case"><a href={`/projects/${p.id}`} class="pidx__link">
      <span class="pidx__n ch-num">{String(i + 1).padStart(2, '0')}</span>
      <span class="pidx__title">{p.data.title}</span>
      <span class="pidx__meta">{[p.data.sector, p.data.location?.split(',')[0]].filter(Boolean).join(' · ')}</span>
      <span class="pidx__units">{p.data.unitsLabel ?? (p.data.units ? `${p.data.units.toLocaleString()} units` : '')}</span>
      <span class="pidx__thumb fill">{p.data.hero && <Pic src={p.data.hero.src} alt="" sizes="200px" widths={[240, 480]} />}</span>
    </a></li>)}</ol>
  </section>
  <section class="section--loose stone light-section" data-theme="light"><div class="wrap grid grid--2" style="gap:96px;align-items:start"><div><div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">How we work with professionals</span><h2>Specification to handover.</h2></div><ProcessList steps={steps} /></div><div class="stack"><PersonCard name="Eddie Lever" role="National Sales Manager — Warrington project office" ask="developer, retirement-living, hotel and commercial specification anywhere in the UK" contactHref={site.projectsPhoneHref} contactLabel={`Warrington ${site.projectsPhone}`} /><p class="small" style="color:var(--slate)">Clients include {clients.slice(0, 8).join(', ')}.</p><div><a class="z-btn z-btn--primary" href={site.tradeCta.href}>{site.tradeCta.label}</a></div></div></div></section>
</Base>
<style>
  .light-section { color: var(--ink); } .light-section h2 { color: var(--ink); }
  .pidx__head { margin-bottom: var(--space-6); }
  .pidx { list-style: none; margin: 0; padding: 0; border-top: 1px solid #343a44; }
  .pidx__row { border-bottom: 1px solid #343a44; background: transparent; border-left: 0; border-right: 0; max-width: none; }
  .pidx__link { display: grid; grid-template-columns: 56px minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, .7fr) 160px; align-items: center; gap: var(--space-5); padding: var(--space-4) 0; text-decoration: none; color: inherit; }
  .pidx__title { font-family: var(--font-display); font-weight: 300; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.1; color: var(--on-panel); letter-spacing: -0.01em; font-variation-settings: 'opsz' 144; }
  .pidx__meta, .pidx__units { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: #9aa0a9; }
  .pidx__thumb { aspect-ratio: 3 / 2; width: 160px; background: var(--surface-raised); }
  .pidx__thumb :global(img) { transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .pidx__link:hover .pidx__thumb :global(img) { transform: scale(1.04); }
  .pidx__link:hover .pidx__title { color: var(--accent-text); }
  @media (max-width: 900px) { .pidx__link { grid-template-columns: 40px 1fr 96px; grid-template-areas: "n t img" "n m img" "n u img"; gap: 4px var(--space-4); } .pidx__n { grid-area: n; } .pidx__title { grid-area: t; } .pidx__meta { grid-area: m; } .pidx__units { grid-area: u; } .pidx__thumb { grid-area: img; width: 96px; } }
</style>
