---
import Page from '../layouts/Page.astro';
import { site } from '../data/site';
---
<Page title="Contact Zest, Chester" description="Call, email or visit Zest Bathrooms & Kitchens at Brookdale Place, Chester. Open Monday to Saturday." eyebrow="Contact" heading="Say hello." lead="The showroom is the best place to start, but a call or a note works too." cta={false}>
  <section class="wrap section" style="padding-top:0"><div class="grid grid--2" style="gap:96px;align-items:start">
    <form class="stack" name="general-enquiry" method="POST" data-netlify="true" netlify-honeypot="company-website" action="/thank-you">
      <input type="hidden" name="form-name" value="general-enquiry" />
      <p class="honey"><label>Leave this empty <input name="company-website" /></label></p>
      <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" required autocomplete="name" /></div>
      <div class="grid grid--2"><div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" required autocomplete="email" /></div><div class="field"><label for="c-phone">Phone (optional)</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" /></div></div>
      <div class="field"><label for="c-msg">How can we help?</label><textarea id="c-msg" name="message" rows="5" required></textarea></div>
      <div><button class="z-btn z-btn--primary" type="submit">Send</button></div>
      <p class="caption">We reply within one working day. <a href="/privacy">Privacy</a>.</p>
    </form>
    <aside class="stack"><div><h3>Showroom</h3><p class="small" style="margin-top:8px">{site.address.street}<br />{site.address.locality} {site.address.postcode}</p></div><div><h3>Projects office</h3><p class="small" style="margin-top:8px">{site.projectsOffice.street}<br />{site.projectsOffice.locality} {site.projectsOffice.postcode}<br /><a href={site.projectsPhoneHref}>{site.projectsPhone}</a></p></div><div><h3>Hours</h3><p class="small" style="margin-top:8px">Monday–Friday 9am–5pm<br />Saturday 9am–4pm<br />Sunday closed</p></div><div><h3>Phone and email</h3><p class="small" style="margin-top:8px"><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div><h3>Projects — Warrington office</h3><p class="small" style="margin-top:8px"><a href={site.projectsPhoneHref}>{site.projectsPhone}</a><br /><a href="/projects/register">Register a project</a> and the projects team will come back within a working day.</p></div></aside>
  </div></section>
</Page>
