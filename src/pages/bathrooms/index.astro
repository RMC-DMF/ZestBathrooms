---
import Pic from '../../components/Pic.astro';
import Page from '../../layouts/Page.astro';
import Feature from '../../components/Feature.astro';
import Gallery from '../../components/Gallery.astro';
import FullBleed from '../../components/FullBleed.astro';
import Editorial from '../../components/Editorial.astro';
import Work from '../../components/Work.astro';
import Texture from '../../components/Texture.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection } from 'astro:content';
import imgs from '../../data/page-images.json';
import { site } from '../../data/site';
const studies = (await getCollection('caseStudies', ({ data }) => data.room === 'bathrooms' && !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
const brands = (await getCollection('brands', ({ data }) => data.category !== 'Kitchens' && data.category !== 'Appliances')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---
<Page title="Luxury Bathrooms Chester — Gessi, Bette, Novello" description="Luxury bathrooms designed in Chester: Gessi Haute Culture, Bette, Novello, AXOR and wellness rooms, for homes across Cheshire, the Wirral and the North West." accent="bathrooms" eyebrow="Bathrooms — Chester" heading="Rooms for the start of the day." lead="From a cloakroom to a private spa. Brassware, stone and furniture from the European houses we have worked with for decades, designed into rooms you can stand in first." hero={{ src: '/images/home/bathroom-edgeley.jpg', alt: 'Contemporary bathroom with brass fittings, Edgeley, Chester' }}>
  <Editorial overlap tone="light" accent="bathrooms" image="/images/home/green-2.jpg" alt="Dark green bathroom with copper tap, Zest showroom" detail="/images/pages/bathrooms-01.jpg" detailAlt="Marble vanity with black taps" eyebrow="How we design a bathroom" title="Thirty decisions that have to agree." text="Valve and trim, tray and fall, tile and grout line, where the light comes from. We make them with you, in an hour among real displays, then draw the room before anything is ordered. One designer from survey to the day the installer leaves." href="/design-service" linkLabel="How it works" />
  <Texture image="/images/haute-culture/gessi-haute-culture-finiture.jpg" alt="Leather, quilted hide and polished brass — Gessi Haute Culture finishes" line="Couture, for the bathroom." caption="Gessi Haute Culture — made by hand in Piedmont" position="50% 60%" />
  <FullBleed accent="bathrooms" image="/images/home/gessi-haute.jpg" alt="Gessi Venti20 bathroom" eyebrow="Opening January 2027" title="Gessi Haute Culture. One of ten UK showrooms." text="Eight couture collections, specified rather than bought. The dedicated Haute Culture showroom opens in Chester in January; register for a private preview." cta={{ label: 'Register for the preview', href: '/gessi-haute-culture' }} minHeight="70vh" />
  <Work accent="bathrooms" eyebrow="Recent bathrooms" title="Designed in Chester." href="/bathrooms/case-studies" linkLabel="All bathroom case studies" items={studies.slice(0, 3).map((s) => ({ title: s.data.title, href: `/bathrooms/case-studies/${s.id.split('/').pop()}`, image: s.data.hero?.src, alt: s.data.hero?.alt, tags: ['Bathroom', s.data.location?.split(',')[0], s.data.designer && `Designed by ${s.data.designer}`].filter(Boolean) as string[] }))} />
  <section class="light-band section" data-theme="light"><div class="wrap">
    <div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">Brands</span><h2>The houses we work with.</h2><p class="z-heading__lead">Each has its own page: what they're known for, what's on display, and the questions people ask.</p></div>
    <div class="grid grid--4">{brands.map((b) => <a href={`/brands/${b.id}`} class="brand-tile">{b.data.hero ? <div class="fill" style="aspect-ratio:3/2"><Pic src={b.data.hero.src} alt="" sizes="(max-width: 900px) 100vw, 25vw" widths={[320, 480, 640]} /></div> : <div class="brand-tile__mark" aria-hidden="true"><span>{b.data.title}</span></div>}<span class="caption">{b.data.category}</span><h3>{b.data.title}</h3></a>)}</div>
  </div></section>
  <Gallery images={imgs.bathrooms.gallery.map((src: string) => ({ src }))} max={5} eyebrow="Details" title="Stone, brass, light." />
  <Editorial accent="bathrooms" flip image="/images/home/pink-1.jpg" alt="Oxblood bathroom with freestanding bath and brass stand, designed by Zest" detail="/images/pages/our-showroom-49.jpg" detailAlt="AXOR shower head in brushed bronze, Zest showroom" eyebrow="Wellness and surfaces" title="Steam, sauna, slabs." text="Effe steam and sauna, Sunshower, Gessi Private Wellness — designed into the room rather than bolted on. And the slab and tile library in the showroom for the surfaces that make the difference." href="/bathrooms/wellness" linkLabel="Wellness rooms" />
  <section class="wrap section"><div style="max-width:720px"><div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">Questions</span><h2>Before you book</h2></div><FAQ items={[{ q: 'What does a luxury bathroom cost?', a: 'Most bathrooms we design fall between [£X] and [£X] supplied; our <a href="/bathrooms/cost-guide">cost guide</a> explains what moves the number.' }, { q: 'Do you install?', a: 'We supply and project-manage, and work with installers we have used for years. You can use your own too.' }, { q: 'Can I see Gessi Haute Culture?', a: 'Yes, by private appointment in Chester [from date].' }, { q: 'I found the same tap cheaper online.', a: 'You probably did. What the listing doesn\'t include is the specification, the survey, the installer who knows it, and someone to call. We talk about price openly in the showroom — bring the quote.' }]} openFirst /></div></section>
</Page>
<style>.brand-tile { display: block; background: var(--surface-raised); border: var(--hairline) solid var(--line); text-decoration: none; color: inherit; overflow: hidden; }  .brand-tile .caption, .brand-tile h3 { padding-inline: var(--space-4); } .brand-tile .caption { display: block; padding-top: var(--space-4); } .brand-tile h3 { font-size: 20px; padding-bottom: var(--space-4); margin-top: 4px; } .brand-tile:hover { border-color: var(--accent); } .brand-tile__mark { aspect-ratio: 3/2; display: grid; place-items: center; background: radial-gradient(120% 90% at 30% 20%, #262b33, var(--stone)); padding: var(--space-4); } .brand-tile__mark span { font-family: var(--font-display); font-weight: 300; font-size: clamp(22px, 2.2vw, 30px); letter-spacing: .02em; color: var(--on-panel); opacity: .85; text-align: center; line-height: 1.1; }</style>
