---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import FullBleed from '../components/FullBleed.astro';
import Gallery from '../components/Gallery.astro';
import PersonCard from '../components/PersonCard.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const collections = ['Jacqueline', 'Perle', 'Ludovica', 'Pelle', 'Sensazioni', 'Immersiva', 'Riflessioni', 'Glass Connection'];
// Gessi press imagery from gessi.com/en/haute-culture, used with the partnership. Replace with Zest's own showroom photography when the display is in.
const hc = (n: string, alt: string) => ({ src: `/images/haute-culture/gessi-haute-culture-${n}.jpg`, alt });
const gallery = [
  hc('02', 'Embroidered fabric on the roll, checked by hand'),
  hc('05', 'The press that prints the Haute Culture book'),
  hc('11', 'Brass letters laid out on the bench'),
  hc('07', 'The tailor at work on the embroidered cloth'),
  hc('06', 'The gilded Haute Culture plate'),
  hc('10', 'Cutting the fabric by hand'),
  hc('01', 'Proofs of the book being checked'),
  hc('finiture', 'Finishes: leather, quilting and polished metal'),
  hc('13', 'The embroidered presentation box'),
  hc('04', 'Printed sheets, stacked for binding'),
];
const designers = (await getCollection('team', ({ data }) => data.published && /Bathroom Designer/.test(data.role))).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('team', ({ data }) => data.published && /Projects/.test(data.role))).slice(0, 1);
const schema = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: 'Gessi Haute Culture at Zest, Chester',
  description: 'Zest Bathrooms & Kitchens is one of ten Gessi Haute Culture partner showrooms in the UK and the first to launch.',
  isPartOf: { '@id': `${site.url}/#business` },
}];
---
<Base title="Gessi Haute Culture Showroom — Chester" description="Zest is one of ten Gessi Haute Culture partner showrooms in the UK, and the first to launch. See the eight couture collections in Chester by private appointment." accent="bathrooms" dark floatingHeader schema={schema}>
  <Hero image="/images/haute-culture/gessi-haute-culture-casa-gessi.jpg" alt="The Gessi Haute Culture display at Casa Gessi" eyebrow="Gessi Haute Culture · Chester" title="Couture, for the bathroom." text="One of ten Haute Culture showrooms in the UK, and the first to launch. By private appointment on Brookdale Place." cta={{ label: 'Book a private viewing', href: '/book-a-design-appointment?interest=haute-culture' }} position="50% 50%" />

  <Statement>Haute Culture is Gessi's answer to couture: eight collections made by hand in Italy, where jewellery, fashion and design meet. It is specified into a room by a designer, never bought off a shelf — which is why Gessi chose ten showrooms in the UK, not two hundred. Zest was the first of them to open its doors.</Statement>

  <Gallery images={gallery.slice(0, 5)} max={5} />

  <section class="wrap section--loose z-on-dark">
    <div class="grid grid--2" style="gap:96px;align-items:start">
      <div class="z-heading"><span class="z-eyebrow">The collections</span><h2>Eight ways of thinking about water.</h2><p class="z-heading__lead">Each collection takes one idea — a jewel, a leather, a fabric, a reflection — and follows it through brassware, basins, lighting and the pieces around them. Fashion, jewellery and design converge; what comes out is closer to an atelier than a catalogue.</p></div>
      <ol class="hc-list">{collections.map((c, i) => <li><span class="hc-list__n">{String(i + 1).padStart(2, '0')}</span><span class="hc-list__name">{c}</span></li>)}</ol>
    </div>
  </section>

  <FullBleed accent="bathrooms" image="/images/haute-culture/gessi-haute-culture-hero.jpg" alt="The Haute Culture finishes box" eyebrow="Why Zest" title="Chosen by Gessi. First to launch." text="Gessi selected Zest as a Haute Culture Ambassador and official partner showroom — one of ten in the UK. We previewed the collections with Gessi at Milan Design Week in April 2026 and joined the inaugural launch at Casa Gessi London that October. Behind the invitation is three decades of specifying Gessi, in private houses across the North West and in developments and hotels across the country." minHeight="80vh" shade="left" />

  <Gallery images={gallery.slice(5)} max={5} />

  <section class="wrap section--loose z-on-dark">
    <div class="grid grid--2" style="gap:96px;align-items:start">
      <div class="z-heading"><span class="z-eyebrow">In Chester</span><h2>What you can see, and when.</h2><p class="z-heading__lead">The Haute Culture display is being installed in the Brookdale Place showroom [date to confirm with Gessi]. Until then, our bathroom designers can walk you through the collections, finishes and samples by private appointment — and for developments and hotels, our projects team specifies Haute Culture for penthouse and suite schemes.</p></div>
      <div class="stack">
        {designers.map((t) => <PersonCard name={t.data.name} role={t.data.role} photo={t.data.photo} ask={t.data.ask} contactHref={t.data.email ? `mailto:${t.data.email}` : undefined} contactLabel={t.data.email ? `Email ${t.data.name.split(' ')[0]}` : undefined} />)}
        {projects.map((t) => <PersonCard name={t.data.name} role={t.data.role} photo={t.data.photo} ask="Haute Culture for developments and hotels" contactHref={site.phoneHref} contactLabel={site.phone} />)}
      </div>
    </div>
  </section>

  <section class="wrap section z-on-dark" style="padding-top:0"><div style="max-width:720px"><div class="z-heading" style="margin-bottom:var(--space-6)"><span class="z-eyebrow">Questions</span><h2>Haute Culture, practically.</h2></div><FAQ items={[
    { q: 'Can I buy Haute Culture pieces individually?', a: 'The collections are specified as part of a designed room rather than sold piece by piece — that is the point of a partner showroom. Our designers will plan the room around them. [Confirm with Gessi.]' },
    { q: 'How long is the lead time?', a: 'Every piece is made to order in Piedmont. [Lead time to confirm with Gessi.]' },
    { q: 'Is it available for developments and hotels?', a: 'Yes — we specify Haute Culture for penthouse and hospitality schemes through our projects team.' },
    { q: 'Why can I only see it in ten showrooms?', a: 'Gessi chose partners who design rooms rather than sell boxes. Haute Culture needs a designer to specify it, finishes to be seen in the flesh, and a showroom that can do both.' },
  ]} /></div></section>

  <section class="section--loose z-on-dark" style="border-top:1px solid #343a44"><div class="wrap stack" style="align-items:center;text-align:center;gap:32px"><h2 style="max-width:720px;font-size:clamp(36px,4.2vw,56px);line-height:1">See it in Chester.</h2><a class="z-btn z-btn--primary z-btn--on-dark" href="/book-a-design-appointment?interest=haute-culture">Book a private viewing</a></div></section>
</Base>
<style>
  .dark .z-heading__lead { color: #cfd3d9; }
  .hc-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .hc-list li { display: flex; align-items: baseline; gap: 16px; padding: 18px 0; border-bottom: 1px solid #343a44; }
  .hc-list__n { font-family: var(--font-text); font-size: 12px; letter-spacing: .12em; color: var(--accent-text); }
  .hc-list__name { font-family: var(--font-display); font-size: 28px; font-weight: 300; color: var(--on-panel); }
  @media (max-width: 700px) { .hc-list { grid-template-columns: 1fr; } }
</style>
