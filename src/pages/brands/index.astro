---
import Page from '../../layouts/Page.astro';
import Pic from '../../components/Pic.astro';
import { getCollection } from 'astro:content';
const brands = (await getCollection('brands')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const groups = [...new Set(brands.map((b) => b.data.category))];
---
<Page title="Brands — Kitchens, Brassware, Sanitaryware, Wellness" description="The houses Zest works with: SieMatic, Gessi, AXOR, Bette, Novello, Villeroy & Boch, Gaggenau, Effe and more, on display in Chester." eyebrow="Brands" heading="The houses we work with." lead="Chosen over three decades for how they are made, not how they are marketed. Most are on display in Chester.">
  {groups.map((g) => <section class="wrap section" style="padding-top:0"><div class="z-heading" style="margin-bottom:var(--space-5)"><span class="z-eyebrow">{g}</span></div><div class="grid grid--4">{brands.filter((b) => b.data.category === g).map((b) => <a href={`/brands/${b.id}`} class="brand-tile">{b.data.hero ? <div class="fill brand-tile__img"><Pic src={b.data.hero.src} alt="" sizes="(max-width: 900px) 50vw, 25vw" widths={[320, 480, 640]} /></div> : <div class="brand-tile__mark" aria-hidden="true"><span>{b.data.title}</span></div>}<div class="brand-tile__body"><span class="caption">{b.data.country}{b.data.founded && !/\[/.test(b.data.founded) && ` · since ${b.data.founded}`}</span><h3>{b.data.title}</h3>{b.data.tagline && !/\[/.test(b.data.tagline) && <p class="small brand-tile__tag">{b.data.tagline}</p>}</div></a>)}</div></section>)}
</Page>
<style>.brand-tile { display: block; background: var(--surface-raised); border: var(--hairline) solid var(--line); text-decoration: none; color: inherit; overflow: hidden; } .brand-tile__img { aspect-ratio: 4 / 3; } .brand-tile__img :global(img) { transition: transform .8s cubic-bezier(.2,.7,.2,1); } .brand-tile:hover .brand-tile__img :global(img) { transform: scale(1.04); } .brand-tile:hover { border-color: var(--accent); } .brand-tile__body { padding: var(--space-4); } .brand-tile h3 { margin-top: 4px; font-size: 20px; } .brand-tile__tag { color: var(--slate); margin-top: 6px; } .brand-tile__mark { aspect-ratio: 4/3; display: grid; place-items: center; background: radial-gradient(120% 90% at 30% 20%, #262b33, var(--stone)); padding: var(--space-4); } .brand-tile__mark span { font-family: var(--font-display); font-weight: 300; font-size: clamp(22px, 2.2vw, 30px); color: var(--on-panel); opacity: .85; text-align: center; line-height: 1.1; }</style>
