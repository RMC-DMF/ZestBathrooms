---
import Pic from '../../components/Pic.astro';
import Page from '../../layouts/Page.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../../data/site';
const copy = await getEntry('pages', 'showroom');
const { Content } = await render(copy!);
const display = await getEntry('pages', 'siematic-display');
const { Content: Display } = display ? await render(display) : { Content: null };
---
<Page title="The Showroom — Brookdale Place, Chester" description="Visit the Zest showroom in Chester: SieMatic kitchen displays, bathroom settings, working showers and the Gessi Haute Culture collection, two minutes from the city walls." accent="design" eyebrow="The showroom — Chester" heading="See it before you choose it." lead="Four SieMatic kitchen displays, more than forty bathroom settings across two floors, working showers and steam, and a tile studio — 5,000 sq ft in all, two minutes from the city walls. Appointments recommended; the showroom is being refurbished through to the New Year." hero={{ src: '/images/home/gessi-2.jpg', alt: 'Terrazzo basin wall and teal tiles, Zest showroom, Chester' }} cta={{ title: 'Plan a visit.', text: 'Drop in during opening hours, or book so a designer is free for you.', label: 'Book a design appointment', href: site.cta.href }}>
  <section class="wrap section"><div class="grid grid--2" style="gap:96px;align-items:start"><div class="prose"><Content />{Display && <><h2>The SieMatic display</h2><Display /></>}</div><aside class="stack"><div class="z-person" style="display:block;max-width:none"><h3 style="margin-bottom:12px">Find us</h3><p class="small">{site.address.street}<br />{site.address.locality} {site.address.postcode}</p><p class="small" style="margin-top:12px">{site.hours.map((h) => <>{h.days}: {h.open}–{h.close}<br /></>)}Sunday closed</p><p class="small" style="margin-top:12px"><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p><p class="small" style="margin-top:12px"><a href="https://maps.google.com/?q=Zest+Bathrooms+%26+Kitchens+Chester" rel="noopener">Open in Google Maps</a> · Parking is easiest in the city-centre car parks a few minutes' walk away; call ahead and we will point you to the nearest.</p></div><div><h3 style="margin-bottom:12px">On display</h3><ul class="small" style="padding-left:1.2em;color:var(--slate)"><li>Four SieMatic kitchen displays in around 1,000 sq ft, with Gaggenau, Miele, Siemens, Bora and Quooker — including the 2026 display in graphite smoked oak and Black Tempest stone</li><li>Two floors of bathrooms: around forty settings in 4,000 sq ft</li><li>Working water: a Hansgrohe and AXOR shower area, a working steam room and a working Gessi shower system</li><li>Brassware from Gessi, AXOR, Dornbracht, Samuel Heath, Lefroy Brooks, Crosswater and Coalbrook; sanitaryware and furniture from Duravit, Villeroy &amp; Boch, Cielo, Artelinea, Novello, Oasis, Thomas Crapper and Burbridge; baths and showers from Bette, Matki, Merlyn and Sunshower</li><li>The Gessi Haute Culture showroom, opening January 2027</li><li>A dedicated tile studio of Spanish and Italian tiles — Mirage, Peronda, Emilgroup, Novabell, Benadresa, Museum, Energieker and Imola</li></ul></div></aside></div></section>
  {copy!.data.gallery.length > 0 && <section class="wrap section" style="padding-top:0"><div class="grid grid--3">{copy!.data.gallery.slice(0, 9).map((g) => <div class="fill" style="aspect-ratio:4/3"><Pic src={g.src} alt={g.alt || 'Zest showroom, Chester'} sizes="(max-width: 900px) 100vw, 33vw" widths={[400, 640, 900]} /></div>)}</div></section>}
</Page>
