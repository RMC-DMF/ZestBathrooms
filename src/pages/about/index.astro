---
import Page from '../../layouts/Page.astro';
import FactStrip from '../../components/FactStrip.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../../data/site';
const story = await getEntry('pages', 'our-story');
const about = await getEntry('pages', 'about');
const { Content: Story } = await render(story!);
const { Content: About } = about ? await render(about) : { Content: null };
const timeline = [
  { year: '1992', text: 'Zest opens as a specialist bathroom showroom.' },
  { year: '2019', text: 'Renaker Deansgate Square — 1,508 apartments, the largest residential scheme in the North West.' },
  { year: '2026', text: 'Selected as one of ten Gessi Haute Culture showrooms in the UK.' },
  { year: '2027', text: 'The Gessi Haute Culture showroom opens in Chester in January.' },
];
---
<Page title="About Zest — Chester, Since 1992" description="Zest Bathrooms & Kitchens: a Chester showroom and design studio since 1992, supplying homes across the North West and developments across the UK." eyebrow="About — our story" heading="Thirty-four years of rooms." lead="Founded in 1992 as a bathroom showroom. Still independent, still in Chester — with a projects office in Warrington and a KBB Awards customer service award on the shelf." hero={story?.data.hero}>
  <FactStrip facts={site.facts} />
  <section class="wrap section"><div class="grid grid--2" style="gap:96px;align-items:start"><div class="prose"><Story /></div><div><div class="z-heading" style="margin-bottom:var(--space-5)"><span class="z-eyebrow">Timeline</span><h2 style="font-size:28px">Milestones</h2></div><ol class="tl">{timeline.map((t) => <li><span class="tl__y">{t.year}</span><span>{t.text}</span></li>)}</ol><div class="cluster" style="margin-top:var(--space-6)"><a class="z-btn z-btn--secondary" href="/about/team">Meet the team</a><a class="z-btn z-btn--link" href="/about/showroom">The showroom <svg class="z-btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></a></div></div></div></section>
</Page>
<style>.tl { margin: 0; padding: 0; list-style: none; border-top: var(--hairline) solid var(--line); } .tl li { display: grid; grid-template-columns: 72px 1fr; gap: var(--space-4); padding: var(--space-3) 0; border-bottom: var(--hairline) solid var(--line); font-size: 15px; } .tl__y { font-family: var(--font-display); font-size: 20px; color: var(--slate); }</style>
