---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Work from '../components/Work.astro';
import MaterialToSpace from '../components/MaterialToSpace.astro';
import FullBleed from '../components/FullBleed.astro';
import Editorial from '../components/Editorial.astro';
import Chapter from '../components/Chapter.astro';
import Texture from '../components/Texture.astro';
import ProcessLive from '../components/ProcessLive.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.filter((p) => p.data.featured).sort((a, b) => (b.data.units ?? 0) - (a.data.units ?? 0)).slice(0, 3);
const unitCount = allProjects.reduce((n, p) => n + (p.data.units ?? 0), 0);
const steps = [
  { title: 'Showroom visit', text: 'An hour with a designer among real displays, not samples.', image: '/images/pages/our-showroom-65.jpg', alt: 'Marble shower with a brass frame between striped tiled walls, Zest showroom' },
  { title: 'Survey and brief', text: 'We measure the room and agree what it has to do for you.', image: '/images/pages/design-service-18.jpg', alt: 'A kitchen photographed in black and white before the design begins' },
  { title: 'Design and specification', text: 'Layouts, 3D visuals and a specification with every product named.', image: '/images/pages/design-service-02.jpg', alt: 'A kitchen half-drawn as a line sketch, half-rendered' },
  { title: 'Supply and installation support', text: 'Your installer or one of ours; we stay until it is finished.', image: '/images/pages/design-service-13.webp', alt: 'Brushed-brass tap on a marble worktop, fitted' },
];
---
<Base title="Luxury Kitchens & Bathrooms, Chester | Zest Bathrooms & Kitchens" description={site.description} dark floatingHeader>
  <Hero
    image="/images/home/gessi-onyx.jpg"
    mobileImage="/images/mobile/gessi-onyx-portrait.jpg"
    alt="Gessi rain showers in copper against a book-matched onyx wall"
    eyebrow="Chester · Luxury bathrooms and kitchens since 1992"
    title="Rooms worth coming home to."
    text="SieMatic kitchens, Gessi bathrooms, and one studio that designs both."
    link={{ label: 'Begin', href: '#doors' }}
    position="60% 50%"
  />

  <div id="doors"><Manifesto note="Designed in Chester since 1992">A beautiful room changes how a home looks. <em>A considered room changes how it feels to live there.</em></Manifesto></div>

  <Texture image="/images/journal/luxury-kitchen-trends-2026-what-high-end-clients-really-want-03.webp" alt="Brass handle on dark lacquered cabinetry, close up" line="It starts with the material." caption="Brushed brass on dark lacquer — SieMatic" />

  <Chapter number="01" accent="kitchens" image="/images/pages/introducing-our-new-siematic-display-08.webp" mobile="/images/mobile/siematic-display-08-portrait.jpg" alt="The 2026 SieMatic display in graphite smoked oak and Black Tempest stone, Zest showroom" eyebrow="Kitchens" title="The kitchen. The heart of everything." text="SieMatic, planned by our own studio and specified for the way your household actually cooks, eats and gathers. Four displays on the floor in Chester, with the appliances in." href="/kitchens" linkLabel="Explore kitchens" position="50% 55%" />
  <Editorial number="02" overlap tone="light" accent="bathrooms" image="/images/home/bathroom-edgeley.jpg" alt="Plaster-pink bathroom with brushed-brass brassware, Edgeley, Chester — designed by Zest" detail="/images/home/green-2.jpg" detailAlt="Deep green basin wall with copper tap, Zest showroom" eyebrow="Bathrooms" title="The bathroom. A moment entirely your own." text="From a cloakroom to a private spa. Brassware, stone and furniture from the European houses we have worked with for decades, designed into rooms like this one in Chester." href="/bathrooms" linkLabel="Explore bathrooms" position="50% 55%" />
  <Work number="03" eyebrow="Projects" title={`${unitCount.toLocaleString()} units. ${allProjects.length} developments. One supplier.`} text="Specification and supply for developers, architects and hotels across the UK — Renaker, Capital & Centric, Domis, Audley, Fragrance Group — run from the Warrington project office." href="/projects" linkLabel="See the work" secondary={site.tradeCta} items={projects.map((p) => ({ title: p.data.title, href: `/projects/${p.id}`, image: p.data.hero?.src, alt: p.data.hero?.alt, tags: [p.data.sector, p.data.location?.split(',')[0], p.data.units && `${p.data.units.toLocaleString()} units`].filter(Boolean) as string[] }))} />

  <MaterialToSpace eyebrow="From the material to the room" title="A slab of stone becomes a wall. A wall becomes a room." text="Every room starts with one decision — a marble, a timber, a finish — and every other decision follows from it. This is the Brookdale Place showroom, where you can stand in the result." href="/about/showroom" linkLabel="Walk the showroom" frames={[
    { src: '/images/pages/our-showroom-43.jpg', alt: 'Striped marble against pink plaster, Zest showroom', label: 'Material' },
    { src: '/images/pages/our-showroom-46.jpg', alt: 'Marble shower with a brass frame and striped tiles, Zest showroom', label: 'Detail' },
    { src: '/images/pages/our-showroom-74.jpg', alt: 'Freestanding bath in a plaster-pink bathroom, Zest showroom', label: 'Space' },
  ]} />

  <FullBleed id="haute" accent="bathrooms" image="/images/home/gessi-haute.jpg" alt="Gessi Venti20 bathroom in a mirrored, marble room" eyebrow="Opening January 2027" title="Gessi Haute Culture. One of ten showrooms in the UK." text="Eight couture collections, made by hand in Italy and specified rather than bought. Zest is a Haute Culture Ambassador and official partner showroom; the dedicated Haute Culture space opens in Chester in January 2027. Register for a private preview." cta={{ label: 'Register for the preview', href: '/gessi-haute-culture' }} />

  <section id="design" class="section--loose z-accent--design light-section" data-theme="light">
    <div class="wrap">
      <div class="z-heading design__head">
        <span class="z-eyebrow">The design service</span>
        <h2 class="design__title">One studio. Both rooms. Start to finish.</h2>
        <p class="z-heading__lead">The design service is free — an hour in the showroom with a designer, a survey, layouts and a full specification, with no fee at any stage.</p>
      </div>
      <ProcessLive steps={steps}><a class="z-btn z-btn--primary" href={site.cta.href}>{site.cta.label}</a></ProcessLive>
    </div>
  </section>

  <FullBleed id="showroom" accent="design" align="center" shade="left" minHeight="80vh" image="/images/home/gessi-2.jpg" alt="Terrazzo basin wall and teal tiles, Zest showroom, Chester" eyebrow="The showroom — Brookdale Place, Chester" title="See it before you choose it." text="Four SieMatic kitchen displays and more than forty bathroom settings across two floors, with working showers and steam, two minutes from the city walls. Serving Chester, Cheshire, the Wirral, North Wales, Liverpool and Manchester." cta={{ label: 'Plan a visit', href: '/about/showroom' }} link={{ label: 'Request the brochures', href: '/kitchens/brochures' }} />

  <section class="close z-on-dark">
    <div class="wrap close__in">
      <span class="z-eyebrow z-heading">Your next chapter</span>
      <h2 class="close__t z-heading">Start with an hour <em>in the showroom.</em></h2>
      <p class="close__p z-heading">Bring a plan, a photo or just an idea. The design service is free, and an hour with one of our designers is the quickest way to find out what your room could be.</p>
      <div class="cluster close__act z-heading">
        <a class="z-btn z-btn--primary z-btn--on-dark" href={site.cta.href}>{site.cta.label}</a>
        <a class="close__phone" href={site.phoneHref}>or call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .light-section { background: var(--stone); color: var(--ink); }
  .light-section h2, .light-section .z-heading__lead { color: var(--ink); }
  .light-section .z-heading__lead { color: var(--slate); }
  .design__head { max-width: 640px; margin-bottom: var(--space-7); }
  .design__title { font-size: clamp(36px, 4.2vw, 60px); line-height: 1.02; font-weight: 300; letter-spacing: -0.015em; font-variation-settings: 'opsz' 144; }
  .close { padding-block: clamp(112px, 16vw, 224px); border-top: 1px solid #343a44; }
  .close__in { display: flex; flex-direction: column; gap: var(--space-5); }
  .close__t { max-width: 1100px; font-size: clamp(44px, 7.2vw, 112px); line-height: .98; font-weight: 300; letter-spacing: -0.02em; font-variation-settings: 'opsz' 144; color: var(--on-panel); text-wrap: balance; }
  .close__t em { font-style: italic; color: #cfd3d9; }
  .close__p { max-width: 520px; font-size: 17px; line-height: 1.7; color: #cfd3d9; }
  .close__act { gap: 28px; align-items: center; margin-top: var(--space-3); }
  .close__phone { font-size: 15px; color: #9aa0a9; text-decoration: none; }
  .close__phone:hover { color: var(--on-panel); }
</style>
