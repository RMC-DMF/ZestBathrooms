---
import Pic from '../components/Pic.astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Work from '../components/Work.astro';
import MaterialToSpace from '../components/MaterialToSpace.astro';
import FullBleed from '../components/FullBleed.astro';
import Editorial from '../components/Editorial.astro';
import Chapter from '../components/Chapter.astro';
import Texture from '../components/Texture.astro';
import ProcessLive from '../components/ProcessLive.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { byCompletion, completedYear, scaleLabel } from '../lib/projects';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.filter((p) => p.data.featured).sort(byCompletion).slice(0, 3);
const unitCount = allProjects.reduce((n, p) => n + (p.data.units ?? 0), 0);
const steps = [
  { title: 'Showroom visit', text: 'An hour with a designer among real displays, not samples.', image: '/images/showroom/stone-double-vanity-and-onyx-walk-in-shower-zest-showroom.webp', alt: 'Stone double vanity beside a black onyx walk-in shower, Zest showroom' },
  { title: 'Survey and brief', text: 'We measure the room and agree what it has to do for you.', image: '/images/pages/design-service-18.jpg', alt: 'A kitchen photographed in black and white before the design begins' },
  { title: 'Design and specification', text: 'Layouts, 3D visuals and a specification with every product named.', image: '/images/pages/kitchen-half-drawn-as-a-line-sketch-and-half-rendered-in-oak-and.jpg', alt: 'A kitchen half-drawn as a line sketch, half-rendered' },
  { title: 'Supply and installation support', text: 'Your installer or one of ours; we stay until it is finished.', image: '/images/pages/gold-pull-out-tap-over-a-marble-effect-sink-with-a-lit-edge-close-up.webp', alt: 'Brushed-brass tap on a marble worktop, fitted' },
];
---
<Base title="Luxury Kitchens & Bathrooms, Chester | Zest Bathrooms & Kitchens" description={site.description} dark floatingHeader ogImage="/images/home/gessi-onyx.jpg">
  <Hero
    image="/images/home/gessi-onyx.jpg"
    mobileImage="/images/mobile/gessi-onyx-portrait.jpg"
    alt="Gessi rain showers in copper against a book-matched onyx wall"
    eyebrow="Chester · Luxury bathrooms and kitchens since 1992"
    title="Rooms worth coming home to."
    text="SieMatic kitchens, Gessi bathrooms, and one studio that designs both."
    link={{ label: 'Begin', href: '#doors' }}
    position="60% 50%"
  />

  <div id="doors"><Manifesto note="One studio, since 1992">We design kitchens and bathrooms around the way a household actually lives — <em>and we have done it from the same showroom in Chester for over thirty years.</em></Manifesto></div>

  <Texture image="/images/journal/bronze-handle-on-a-smoked-glass-siematic-cabinet-door-close-up.webp" alt="Brass handle on dark lacquered cabinetry, close up" line="It starts with the material." caption="Brushed brass on dark lacquer — SieMatic" />

  <Chapter number="01" accent="kitchens" image="/images/case-studies/kitchens/walnut-porcelain-kitchen-01.webp" mobile="/images/mobile/walnut-porcelain-kitchen-01-portrait.jpg" alt="Walnut SieMatic kitchen with a veined porcelain waterfall island under roof lights, designed by Zest" eyebrow="Kitchens" title="The kitchen. The heart of everything." text="SieMatic, planned by our own studio and specified for the way your household actually cooks, eats and gathers. Four displays on the floor in Chester, with the appliances in." href="/kitchens" linkLabel="Explore kitchens" position="45% 60%" inspect={{ src: '/images/case-studies/kitchens/walnut-porcelain-kitchen-06.webp', alt: 'Four Gaggenau ovens set into walnut tall units, close up', caption: 'Walnut · Gaggenau ovens · SieMatic' }} />
  <Editorial number="02" overlap morph tone="light" accent="bathrooms" image="/images/home/bathroom-stone-wall.webp" alt="Wet room with a sculpted stone wall, open shower and copper pendants" detail="/images/home/bathroom-detail-tile.webp" detailAlt="Freestanding bath against grey tiles with a timber shelf and rattan chair" eyebrow="Bathrooms" title="The bathroom. A moment entirely your own." text="From a cloakroom to a private spa. Brassware, stone and furniture from the European houses we have worked with for decades, designed around the way you live." href="/bathrooms" linkLabel="Explore bathrooms" position="50% 55%" />
  <Work number="03" eyebrow="Projects" title={`${unitCount.toLocaleString()} units. ${allProjects.length} developments. One supplier.`} text="Specification and supply for developers, architects and hotels across the UK — Far East Consortium, Capital & Centric, Domis, Audley, Fragrance Group — run from the Warrington project office." href="/projects" linkLabel="See the work" secondary={site.tradeCta} items={projects.map((p, i) => ({ title: p.data.title, href: `/projects/${p.id}`, image: p.data.hero?.src, alt: p.data.hero?.alt, tags: [p.data.sector, p.data.location?.split(',')[0], completedYear(p) && `Completed ${completedYear(p)}`, scaleLabel(p)].filter(Boolean) as string[] }))} />

  <MaterialToSpace eyebrow="From the material to the room" title="Pick the material first. We plan the room around it." text="Most of our rooms start with one sample — a marble, a timber, a finish — and the rest follows: the brassware that suits it, the light that shows it, the furniture that does not fight it. In the Brookdale Place showroom you can stand in the result rather than imagine it." href="/about/showroom" linkLabel="Walk the showroom" frames={[
    { src: '/images/home/material-agate.webp', alt: 'Agate slab — bands of amber, smoke and white crystal, close up', label: 'Material' },
    { src: '/images/home/detail-porcelain-island.webp', alt: 'Veined porcelain slab wrapping the corner of a kitchen island', label: 'Detail' },
    { src: '/images/home/space-walnut-kitchen.webp', alt: 'Walnut kitchen with a porcelain island under roof lights, garden beyond — designed by Zest', label: 'Space' },
  ]} />

  <FullBleed id="haute" accent="bathrooms" image="/images/home/gessi-haute.jpg" alt="Gessi Venti20 bathroom in a mirrored, marble room" eyebrow="Opening January 2027" title="Gessi Haute Culture. One of ten showrooms in the UK." text="Eight couture collections, made by hand in Italy and specified rather than bought. Zest is a Haute Culture Ambassador and official partner showroom; the dedicated Haute Culture space opens in Chester in January 2027. Register for a private preview." cta={{ label: 'Register for the preview', href: '/gessi-haute-culture' }} />

  <section id="design" class="section--loose z-accent--design light-section" data-theme="light">
    <div class="wrap">
      <div class="z-heading design__head">
        <span class="z-eyebrow">The design service</span>
        <h2 class="design__title">The design service is free. It starts with an hour in the showroom.</h2>
        <p class="z-heading__lead">An hour with a designer among real displays, then a survey, layouts, 3D visuals and a written specification — no fee at any stage, and no obligation to buy.</p>
      </div>
      <ProcessLive steps={steps}><a class="z-btn z-btn--primary" href={site.cta.href}>{site.cta.label}</a></ProcessLive>
    </div>
  </section>

  <FullBleed id="showroom" accent="design" align="center" shade="left" minHeight="80vh" image="/images/home/gessi-2.jpg" alt="Terrazzo basin wall and teal tiles, Zest showroom, Chester" eyebrow="The showroom — Brookdale Place, Chester" title="See it before you choose it." text="Four SieMatic kitchen displays and more than forty bathroom settings across two floors, with working showers and steam, two minutes from the city walls. Serving Chester, Cheshire, the Wirral, North Wales, Liverpool and Manchester." cta={{ label: 'Plan a visit', href: '/about/showroom' }} link={{ label: 'Request the brochures', href: '/kitchens/brochures' }} />

  <section class="close z-on-dark">
    <div class="wrap close__in">
      <span class="z-eyebrow z-heading">Your next chapter</span>
      <h2 class="close__t z-heading">Start with an hour <em>in the showroom.</em></h2>
      <p class="close__p z-heading">Bring a plan, a photo or just an idea. The design service is free, and an hour with one of our designers is the quickest way to find out what your room could be.</p>
      <div class="cluster close__act z-heading">
        <a class="z-btn z-btn--primary z-btn--on-dark" href={site.cta.href}>{site.cta.label}</a>
        <a class="close__phone" href={site.phoneHref}>or call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .light-section { background: var(--stone); color: var(--ink); }
  .light-section h2, .light-section .z-heading__lead { color: var(--ink); }
  .light-section .z-heading__lead { color: var(--slate); }
  .design__head { max-width: 640px; margin-bottom: var(--space-7); }
  .design__title { font-size: clamp(36px, 4.2vw, 60px); line-height: 1.02; font-weight: 300; letter-spacing: -0.015em; font-variation-settings: 'opsz' 144; }
  .close { padding-block: clamp(112px, 16vw, 224px); border-top: 1px solid #343a44; }
  .close__in { display: flex; flex-direction: column; gap: var(--space-5); }
  .close__t { max-width: 1100px; font-size: clamp(44px, 7.2vw, 112px); line-height: .98; font-weight: 300; letter-spacing: -0.02em; font-variation-settings: 'opsz' 144; color: var(--on-panel); text-wrap: balance; }
  .close__t em { font-style: italic; color: #cfd3d9; }
  .close__p { max-width: 520px; font-size: 17px; line-height: 1.7; color: #cfd3d9; }
  .close__act { gap: 28px; align-items: center; margin-top: var(--space-3); }
  .close__phone { font-size: 15px; color: #9aa0a9; text-decoration: none; }
  .close__phone:hover { color: var(--on-panel); }
</style>
